        "@types/supertest": "^6.0.2",
        "@types/uuid": "^10.0.0",
        "jest": "^29.7.0",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.3",
        "ts-node": "^10.9.2",
        "typescript": "^5.5.4"
